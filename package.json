{
  "name": "@ajuwm/dsh-roleplay-plugin",
  "version": "1.5.25",
  "description": "DSH 角色扮演插件（恋爱向 / 朋友向 / OC 原创向）：角色卡库、亲密关系与里程碑、养成与背包、心跳主动消息、日记与记忆、世界书、ST 角色卡（PNG/JSON）导入导出、桌宠窗口。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./settings": "./lib/settings.js",
    "./package.json": "./package.json",
    "./deskpet": "./agent-presets/roleplay/deskpet.mjs"
  },
  "files": [
    "lib",
    "agent-presets",
    "pet",
    "docs",
    "install.ps1",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README-cn.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "roleplay",
    "character-card",
    "sillytavern",
    "ai-companion",
    "desktop-pet",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "ajuwm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajuwm/dsh-roleplay-plugin.git"
  },
  "homepage": "https://github.com/ajuwm/dsh-roleplay-plugin#readme",
  "bugs": {
    "url": "https://github.com/ajuwm/dsh-roleplay-plugin/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
